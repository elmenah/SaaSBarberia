# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (Supabase Postgres direct) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-random-secret-32-chars
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── n8n Webhooks ────────────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_NEW_APPOINTMENT=https://your-n8n-instance.com/webhook/barberos-nueva-reserva
N8N_WEBHOOK_CANCEL_APPOINTMENT=https://your-n8n-instance.com/webhook/barberos-cancelacion
N8N_WEBHOOK_REMINDER=https://your-n8n-instance.com/webhook/barberos-recordatorio-24h
N8N_WEBHOOK_INACTIVE_CLIENT=https://your-n8n-instance.com/webhook/barberos-reactivacion
# Secret compartido entre Next.js y n8n para el endpoint interno de cron jobs
N8N_INTERNAL_SECRET=generate-a-strong-random-secret

# ─── WhatsApp (via n8n / Evolution API) ─────────────────────────────────────
WHATSAPP_INSTANCE_URL=https://your-evolution-api.com
WHATSAPP_API_KEY=your-evolution-key

# ─── App config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=BarberOS
NEXT_PUBLIC_APP_VERSION=0.1.0
